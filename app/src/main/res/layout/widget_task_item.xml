            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_subtask_check_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_circle_outline" />

            <TextView
                android:id="@+id/widget_subtask_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Static Subtask Slot 2 -->
        <LinearLayout
            android:id="@+id/widget_subtask_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_subtask_check_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_circle_outline" />

            <TextView
                android:id="@+id/widget_subtask_text_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Static Subtask Slot 3 -->
        <LinearLayout
            android:id="@+id/widget_subtask_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_subtask_check_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
