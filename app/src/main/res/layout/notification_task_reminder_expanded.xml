            android:paddingVertical="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/notification_subtask_check_4"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_circle_outline" />

            <TextView
                android:id="@+id/notification_subtask_text_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Subtask 5 -->
        <LinearLayout
            android:id="@+id/notification_subtask_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/notification_subtask_check_5"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_circle_outline" />

            <TextView
                android:id="@+id/notification_subtask_text_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Subtask 6 -->
        <LinearLayout
            android:id="@+id/notification_subtask_row_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/notification_subtask_check_6"
                android:layout_width="18dp"
